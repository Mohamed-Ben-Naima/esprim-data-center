# Text
* text=auto
*.md   text eol=lf
*.py   text eol=lf
*.gns3 text eol=lf

# Binaries via Git LFS
*.blend filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.pptx  filter=lfs diff=lfs merge=lfs -text
*.docx  filter=lfs diff=lfs merge=lfs -text
*.xlsx  filter=lfs diff=lfs merge=lfs -text
*.pdf   filter=lfs diff=lfs merge=lfs -text
*.gns3project filter=lfs diff=lfs merge=lfs -text
*.pkt   filter=lfs diff=lfs merge=lfs -text

# Device configs / scripts pushed to Linux & network consoles must keep LF
03_Network/configs/** text eol=lf
03_Network/docker/** text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
03_Network/images/archives/*.zip     filter=lfs diff=lfs merge=lfs -text
03_Network/images/archives/*.zip.*   filter=lfs diff=lfs merge=lfs -text
